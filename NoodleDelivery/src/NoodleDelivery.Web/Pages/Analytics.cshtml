@page
@model AnalyticsModel
@{
    ViewData["Title"] = "Analytics";
}

<h2 class="mb-4">Analytics Dashboard</h2>

<!-- Date range + metric + toggle charts -->
<div class="row mb-3 align-items-end g-2">
    <div class="col-auto">
        <label class="form-label" for="from-date">From</label>
        <input type="date" id="from-date" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="to-date">To</label>
        <input type="date" id="to-date" class="form-control" />
    </div>
    <div class="col-auto mt-3">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="metric" value="kg" id="metric-kg">
            <label class="form-check-label" for="metric-kg">kg</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="metric" value="revenue" id="metric-rev">
            <label class="form-check-label" for="metric-rev">$</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="metric" value="both" id="metric-both" checked>
            <label class="form-check-label" for="metric-both">Both</label>
        </div>
    </div>
    <div class="col-auto mt-3">
        <button class="btn btn-outline-secondary" id="toggle-charts-btn">Toggle Charts</button>
    </div>
</div>

<!-- Toggle panel -->
<div id="toggle-panel" class="mb-3 d-none">
    <div class="card card-body">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="show-top-restaurants" checked>
            <label class="form-check-label" for="show-top-restaurants">Top Restaurants</label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="show-top-drivers" checked>
            <label class="form-check-label" for="show-top-drivers">Top Drivers</label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="show-over-time" checked>
            <label class="form-check-label" for="show-over-time">kg Over Time</label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="show-contribution" checked>
            <label class="form-check-label" for="show-contribution">Revenue Contribution</label>
        </div>
    </div>
</div>

<!-- KPI cards -->
<div class="row mb-4" id="kpi-cards">
    <div class="col-md-3 mb-2">
        <div class="card text-center p-3 kpi-card kpi-blue">
            <h6>Total Volume</h6>
            <p id="kpi-kg" class="fs-5 fw-bold mb-0">-</p>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card text-center p-3 kpi-card kpi-green">
            <h6>Total Revenue</h6>
            <p id="kpi-rev" class="fs-4 fw-bold mb-0">-</p>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card text-center p-3 kpi-card kpi-amber">
            <h6>Top Restaurant</h6>
            <p id="kpi-top-rest" class="fs-5 fw-bold mb-0">-</p>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card text-center p-3 kpi-card kpi-rose">
            <h6>Top Driver</h6>
            <p id="kpi-top-driver" class="fs-5 fw-bold mb-0">-</p>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row">
    <div class="col-md-6 mb-4" id="chart-top-restaurants-wrap">
        <div class="card p-3"><canvas id="chart-top-restaurants"></canvas></div>
    </div>
    <div class="col-md-6 mb-4" id="chart-top-drivers-wrap">
        <div class="card p-3"><canvas id="chart-top-drivers"></canvas></div>
    </div>
    <div class="col-md-8 mb-4" id="chart-over-time-wrap">
        <div class="card p-3">
            <div class="d-flex justify-content-end gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary active" id="ot-btn-all">All</button>
                <button class="btn btn-sm btn-outline-secondary" id="ot-btn-pho">Pho</button>
                <button class="btn btn-sm btn-outline-secondary" id="ot-btn-bun">Bun</button>
            </div>
            <canvas id="chart-over-time"></canvas>
        </div>
    </div>
    <div class="col-12 mb-4" id="chart-contribution-wrap">
        <div class="card p-3">
            <canvas id="chart-contribution" style="max-height: 320px;"></canvas>
        </div>
    </div>
</div>

<!-- Custom query -->
<div class="card mt-2">
    <div class="card-header fw-semibold">Custom Query</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Entity Type</label>
                <select id="entity-type" class="form-select">
                    <option value="restaurant">Restaurant</option>
                    <option value="driver">Driver</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Name</label>
                <select id="entity-name" class="form-select"></select>
            </div>
            <div class="col-auto">
                <label class="form-label">From</label>
                <input type="date" id="cq-from" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label">To</label>
                <input type="date" id="cq-to" class="form-control" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" id="cq-generate">Generate</button>
            </div>
        </div>
        <div id="cq-result" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
